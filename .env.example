# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Pexels API Key for server-side wallpaper proxy (/api/wallpapers)
PEXELS_API_KEY="your_pexels_api_key_here"

# Wallhaven API Key for server-side wallpaper proxy (anime, fantasy, cyberpunk, digital art)
WALLHAVEN_API_KEY=""

# Pixabay API Key (optional server-side aggregator)
PIXABAY_API_KEY=""
