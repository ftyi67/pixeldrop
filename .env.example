# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Pexels API Key for high-resolution wallpaper library & dynamic resizing
NEXT_PUBLIC_PEXELS_API_KEY="your_pexels_api_key_here"
VITE_PEXELS_API_KEY="your_pexels_api_key_here"

# Pixabay API Key for multi-API aggregated wallpaper streaming
NEXT_PUBLIC_PIXABAY_API_KEY="your_pixabay_api_key_here"
VITE_PIXABAY_API_KEY="your_pixabay_api_key_here"
